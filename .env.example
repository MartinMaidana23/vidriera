# --- Tokko Broker ---
# API key: en Tokko, Configuración > Permisos > API key.
# Si se deja vacío, la cartelera arranca en MODO DEMO con propiedades de ejemplo.
TOKKO_API_KEY=

# --- Servidor ---
PORT=3000
# Cada cuántos minutos se vuelven a pedir las propiedades a Tokko
REFRESH_MINUTES=15

# --- Qué propiedades mostrar ---
# Operación: todas | venta | alquiler | alquiler temporario
OPERATION=todas
# Tipos de propiedad separados por coma (vacío = todos). Ej: Departamento,Casa,PH
PROPERTY_TYPES=
# Máximo de propiedades en la rotación
MAX_PROPERTIES=40
# Orden: recientes | precio_asc | precio_desc | aleatorio
SORT=recientes
# Mostrar sólo propiedades con precio publicado (true/false)
ONLY_WITH_PRICE=false

# --- Presentación ---
# Segundos que se muestra cada propiedad
SLIDE_SECONDS=12
# Cantidad de fotos que rotan dentro de cada propiedad
PHOTOS_PER_PROPERTY=4

# --- Datos de la inmobiliaria (pie de pantalla) ---
# Si se dejan vacíos se toman de la sucursal cargada en Tokko (nombre, teléfono, email y logo).
AGENCY_NAME=
AGENCY_PHONE=
# Web o Instagram; si está vacío se muestra el email de la sucursal
AGENCY_WEBSITE=
# URL de un logo (PNG/SVG); se puede dejar el archivo en public/logo.png y poner /logo.png
AGENCY_LOGO_URL=
# Color principal en hexadecimal
ACCENT_COLOR=#e4002b
